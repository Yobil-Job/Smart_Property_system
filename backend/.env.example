# ==============================================================================
# SMARTPROPERTY AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=smartproperty_db;Username=postgres;Password=postgres;

# JWT Security
JWT_SECRET_KEY=SmartPropertyAI_SecretKey_For_Jwt_Authentication_MustBeLongEnough123!
JWT_ISSUER=SmartPropertyAI
JWT_AUDIENCE=SmartPropertyAI_Clients

# ==============================================================================
# AI LLM CONFIGURATION (OpenAI or Groq)
# ==============================================================================
# If using Groq (free API key from https://console.groq.com):
# OPENAI_API_KEY=gsk_your_groq_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# If using OpenAI:
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_TIMEOUT_SECONDS=25

