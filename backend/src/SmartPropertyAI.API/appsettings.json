{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=smartproperty_db;Username=postgres;Password=postgres;"
  },
  "JwtSettings": {
    "SecretKey": "SmartPropertyAI_SecretKey_For_Jwt_Authentication_MustBeLongEnough123!",
    "Issuer": "SmartPropertyAI",
    "Audience": "SmartPropertyAI_Clients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "OpenAISettings": {
    "ApiKey": "",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-120b",
    "MaxTokens": 1000,
    "Temperature": 0.2,
    "TimeoutSeconds": 25
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
